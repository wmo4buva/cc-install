# Ensure PowerShell scripts use Windows (CRLF) line endings
*.ps1 text eol=crlf

# Shell scripts use Unix (LF) line endings
*.sh text eol=lf

# Markdown and text files use native endings
*.md text
*.txt text

# Binary files
*.png binary
*.jpg binary
*.zip binary
*.tar.gz binary
*.pdf binary

# Self-contained HTML guides: keep bytes intact, don't treat as diffable text
docs/installGuides/*.html -text
