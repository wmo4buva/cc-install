# Keep the build context small. The image only needs the container entrypoint;
# everything else (launchers, installers, maintenance scripts, docs) runs on the
# host and must NOT be copied in.

# User data and local state
workspace/
backups/
.env
.env.local
docker-compose.override.yml

# Git
.git/
.gitattributes
.gitignore

# Docs (not needed inside the image)
*.md
docs/
archive/

# Host-side scripts. scripts/container/ is re-included below because the
# Dockerfile COPYs the entrypoint from there.
scripts/*
!scripts/container/

# Root launcher wrappers
claude
claude.cmd
vscode
vscode.cmd

# IDE / OS noise
.vscode/
.idea/
.DS_Store
*.tmp
*.log
*.swp
*~
