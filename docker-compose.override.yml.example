# Optional local overrides for docker-compose.yml.
#
# Copy to `docker-compose.override.yml` to use it — Docker Compose picks that
# filename up automatically, and it is gitignored so your changes survive
# updates. Delete the sections you don't need.

services:
  claude-code:

    # --- Use AWS SSO / a named profile from your host ~/.aws ----------------
    # Mounts your host AWS config read-only so `AWS_PROFILE=...` in .env works
    # without copying keys anywhere. Refresh with `aws sso login` on the HOST,
    # then `ccrestart`.
    #
    # Note: if ~/.aws does not exist, Docker will create an empty directory
    # there. Run `aws configure` (or `aws sso login`) on the host first.
    #
    # volumes:
    #   - ${HOME}/.aws:/home/claudeuser/.aws:ro

    # --- Change the port the browser IDE uses -------------------------------
    # The default is 127.0.0.1:8088:8080 (8080 on the host is heavily contended,
    # so the published port moved off it). Use this if something on your machine
    # already owns 8088 too.
    #
    # The `!override` tag is REQUIRED. Without it Compose MERGES list values by
    # appending, so you would publish BOTH 8088 and your new port and the
    # conflict would remain. `!override` replaces the base file's list.
    # (Needs Docker Compose 2.24+; check with `docker compose version`.)
    #
    # ccvscode reads the published port back from Compose, so it opens the right
    # URL automatically — nothing else to change.
    #
    # ports: !override
    #   - "127.0.0.1:8090:8080"

    # --- Reach the IDE from another machine on your network -----------------
    # DANGER: this exposes code-server beyond this computer. code-server gives
    # whoever opens it a full shell in the container. If you do this you MUST
    # set CC_VSCODE_PASSWORD in .env first.
    #
    # Note the `!override` tag, for the same reason as above.
    #
    # ports: !override
    #   - "0.0.0.0:8088:8080"

    # --- Give the container more memory / CPU -------------------------------
    # deploy:
    #   resources:
    #     limits:
    #       cpus: '4'
    #       memory: 8G

    # --- Mount an extra folder from your computer ---------------------------
    # Makes host files available inside the container at /home/claudeuser/<name>.
    #
    # volumes:
    #   - ${HOME}/Documents/research:/home/claudeuser/research
